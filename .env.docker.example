# =========================
# MediaCrawler Docker 示例配置
# 使用方式：
# 1. 复制一份：cp .env.docker.example .env
# 2. 按需修改下面的变量
# 3. 执行：docker compose up -d
# =========================

# API 服务监听地址和端口
APP_HOST=0.0.0.0
APP_PORT=8080

# 时区
TZ=Asia/Shanghai

# MySQL 配置
MYSQL_ROOT_PASSWORD=123456
MYSQL_DB_HOST=mysql
MYSQL_DB_PORT=3306
MYSQL_DB_USER=root
MYSQL_DB_PWD=123456
MYSQL_DB_NAME=media_crawler
MYSQL_WAIT_TIMEOUT=60
INIT_DB_ON_START=true

# 爬虫基础配置
PLATFORM=zhihu
KEYWORDS=编程副业,编程兼职
LOGIN_TYPE=cookie
CRAWLER_TYPE=creator

## 数据存储配置
SAVE_DATA_OPTION=db
SAVE_DATA_PATH=/app/data

# 浏览器与运行配置
HEADLESS=true
SAVE_LOGIN_STATE=true
ENABLE_CDP_MODE=false
BROWSER_DATA_ROOT=/app/browser_data
MAX_CONCURRENCY_NUM=1
COOKIE_FILE=/run/secrets/zhihu.cookies
VALIDATE_ZHIHU_COOKIE_ON_START=true

# 评论相关配置
ENABLE_GET_COMMENTS=false
ENABLE_GET_SUB_COMMENTS=false
